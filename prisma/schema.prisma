generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String            @id @default(cuid())
  name         String
  email        String            @unique
  passwordHash String
  phone        String?
  createdAt    DateTime          @default(now())
  applications LoanApplication[]
}

// SQLite has no native enum support in Prisma, so LoanStatus and
// EmploymentType are plain strings validated against src/lib/validations.ts.
model LoanApplication {
  id             String   @id @default(cuid())
  user           User     @relation(fields: [userId], references: [id])
  userId         String
  fullName       String
  email          String
  phone          String
  dateOfBirth    String
  address        String
  employmentType String
  employerName   String?
  monthlyIncome  Float
  loanAmount     Float
  loanPurpose    String
  loanTermMonths Int
  interestRate   Float
  monthlyPayment Float
  status         String   @default("SUBMITTED")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
